NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/resq-platform

# Redis (Optional - for caching and performance)
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=your_access_secret_key_here_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_here_change_in_production
JWT_ACCESS_EXPIRY=14d
JWT_REFRESH_EXPIRY=7d

# Twilio SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Twilio Verify API (Recommended for OTP - starts with VA)
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Legacy SMS API (Optional - use either TWILIO_PHONE_NUMBER or TWILIO_MESSAGING_SERVICE_SID)
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Al Fatoorah Payment Gateway
AL_FATOORAH_API_KEY=your_al_fatoorah_api_key
AL_FATOORAH_BASE_URL=https://apitest.myfatoorah.com
AL_FATOORAH_SUCCESS_URL=http://localhost:5000/api/v1/user/booking/payment/success
AL_FATOORAH_ERROR_URL=http://localhost:5000/api/v1/user/booking/payment/error

# CORS
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
FILE_UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# Business Logic
DEFAULT_SEARCH_RADIUS=10
BOOKING_REQUEST_TIMEOUT=60
PAYMENT_TIMEOUT=300
PLATFORM_COMMISSION_PERCENTAGE=20

# AWS S3 Configuration (for document uploads)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=readytogo-dev-bucket
