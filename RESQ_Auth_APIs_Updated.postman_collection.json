{
  "info": {
    "name": "RESQ Auth APIs - Updated Flow",
    "description": "Updated Authentication APIs for RESQ Tow Car Service Platform (User & Driver) with 3-step signup flow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "resq-backend"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "phoneNumber",
      "value": "+919961052060",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "User Auth",
      "item": [
        {
          "name": "1. User Signup - Send OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{phoneNumber}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/user/signup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "user", "signup"]
            },
            "description": "Step 1: Send OTP to user's phone number for signup"
          },
          "response": []
        },
        {
          "name": "2. User Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{phoneNumber}}\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/user/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "user", "verify-otp"]
            },
            "description": "Step 2: Verify OTP code (only phoneNumber and otp required)"
          },
          "response": []
        },
        {
          "name": "3. User Complete Signup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{phoneNumber}}\",\n  \"username\": \"john_doe\",\n  \"password\": \"Password@123\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/user/complete-signup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "user", "complete-signup"]
            },
            "description": "Step 3: Complete user registration with account details"
          },
          "response": []
        },
        {
          "name": "User Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"john_doe\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/user/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "user", "login"]
            },
            "description": "Login with username and password"
          },
          "response": []
        },
        {
          "name": "User Forgot Password - Send OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{phoneNumber}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/user/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "user", "forgot-password"]
            },
            "description": "Send OTP for password reset"
          },
          "response": []
        },
        {
          "name": "User Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{phoneNumber}}\",\n  \"otp\": \"123456\",\n  \"newPassword\": \"NewPassword@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/user/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "user", "reset-password"]
            },
            "description": "Reset password with OTP"
          },
          "response": []
        },
        {
          "name": "User Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/user/refresh-token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "user", "refresh-token"]
            },
            "description": "Refresh access token using refresh token"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Driver Auth",
      "item": [
        {
          "name": "1. Driver Signup - Send OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{phoneNumber}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/driver/signup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "driver", "signup"]
            },
            "description": "Step 1: Send OTP to driver's phone number for signup"
          },
          "response": []
        },
        {
          "name": "2. Driver Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{phoneNumber}}\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/driver/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "driver", "verify-otp"]
            },
            "description": "Step 2: Verify OTP code (only phoneNumber and otp required)"
          },
          "response": []
        },
        {
          "name": "3. Driver Complete Signup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{phoneNumber}}\",\n  \"username\": \"driver_mike\",\n  \"password\": \"Password@123\",\n  \"firstName\": \"Mike\",\n  \"lastName\": \"Smith\",\n  \"email\": \"mike@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/driver/complete-signup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "driver", "complete-signup"]
            },
            "description": "Step 3: Complete driver registration with account details. Note: Driver will have 'pending' approval status."
          },
          "response": []
        },
        {
          "name": "4. Driver Submit Documents",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "vehicleType",
                  "value": "sedan",
                  "type": "text"
                },
                {
                  "key": "vehicleNumber",
                  "value": "ABC-1234",
                  "type": "text"
                },
                {
                  "key": "vehicleMake",
                  "value": "Toyota",
                  "type": "text"
                },
                {
                  "key": "vehicleModel",
                  "value": "Camry",
                  "type": "text"
                },
                {
                  "key": "vehicleYear",
                  "value": "2022",
                  "type": "text"
                },
                {
                  "key": "vehicleColor",
                  "value": "White",
                  "type": "text"
                },
                {
                  "key": "drivingLicense",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "vehicleRegistration",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "insurance",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "nationalId",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/driver/submit-documents",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "driver", "submit-documents"]
            },
            "description": "Step 4: Upload driver documents for verification (requires authentication)"
          },
          "response": []
        },
        {
          "name": "Driver Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"driver_mike\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/driver/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "driver", "login"]
            },
            "description": "Login with username and password"
          },
          "response": []
        },
        {
          "name": "Driver Forgot Password - Send OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{phoneNumber}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/driver/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "driver", "forgot-password"]
            },
            "description": "Send OTP for password reset"
          },
          "response": []
        },
        {
          "name": "Driver Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{phoneNumber}}\",\n  \"otp\": \"123456\",\n  \"newPassword\": \"NewPassword@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/driver/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "driver", "reset-password"]
            },
            "description": "Reset password with OTP"
          },
          "response": []
        },
        {
          "name": "Driver Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/driver/refresh-token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "driver", "refresh-token"]
            },
            "description": "Refresh access token using refresh token"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Common",
      "item": [
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "logout"]
            },
            "description": "Logout (clears refresh token)"
          },
          "response": []
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Check if API is running"
          },
          "response": []
        }
      ]
    }
  ]
}
